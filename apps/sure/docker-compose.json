{
  "schemaVersion": 2,
  "services": [
    {
      "name": "sure-app",
      "image": "ghcr.io/we-promise/sure:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "DB_HOST": "sure-db",
        "DB_USER": "sure",
        "DB_PASSWORD": "${DB_PASSWORD}",
        "REDIS_URL": "redis://sure-redis:6379/1",
        "SECRET_KEY_BASE": "${SECRET_KEY_BASE}",
        "SELF_HOSTED": "true",
        "RAILS_ENV": "production"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/storage",
          "containerPath": "/rails/storage"
        }
      ],
      "dependsOn": ["sure-db", "sure-redis"]
    },
    {
      "name": "sure-db",
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_DB": "sure_production",
        "POSTGRES_USER": "sure",
        "POSTGRES_PASSWORD": "${DB_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/db",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "sure-redis",
      "image": "redis:7-alpine"
    }
  ]
}